{
  "name": "@wiajs/agent",
  "description": "http/https/socks agent",
  "version": "1.0.30",
  "type": "module",
  "main": "index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "default": "./types/index.d.ts"
      },      
      "default": {
        "import": "./index.js",
        "require": "./dist/agent.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production gulp build -f gulpfile.js",
    "lint": "xo",
    "test": "npm run test:node && npm run test:browser && npm run lint",
    "test:node": "istanbul cover _mocha -- test.js test.node.js",
    "test:browser": "karma start --single-run",
    "test:coverage": "cat ./coverage/lcov.info | coveralls"
  },
  "keywords": [
    "agent",
    "http",
    "https",
    "proxy",
    "socks",
    "socks4",
    "socks4a",
    "socks5",
    "socks5h"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wiajs/agent"
  },
  "author": {
    "name": "Sibyl Yu",
    "email": "sibyl@wia.pub"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@wiajs/log": "^4.3.18",
    "socks": "^2.8.3"
  },
  "devDependencies": {},
  "peerDependenciesMeta": {},
  "engines": {
    "node": ">= 13.0"
  }
}
